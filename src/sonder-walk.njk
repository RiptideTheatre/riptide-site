<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex">
<meta name="theme-color" content="#0a1416">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>Sonder · Riptide</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="preload" href="/assets/fonts/space-grotesk-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preconnect" href="https://tiles.openfreemap.org" crossorigin>
<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css">
<link rel="stylesheet" href="/assets/css/sonder-walk.css?v={{ build.v }}">
</head>
<body>
<div class="sw" id="app">

  <header class="sw__bar">
    <a class="sw__brand" href="/sonder/">Sonder</a>
    <span class="sw__step" id="barStep"></span>
  </header>

  <p class="sw__draft" id="draftNote" hidden>Preview: the sound and photos are loaded. The choices, scene names and GPS points are still being confirmed, so use I’m here at each place.</p>

  <!-- 1. Welcome -->
  <section class="sw__screen" data-screen="welcome">
    <p class="sw__eyebrow" id="welcomeEyebrow">Your ticket is ready</p>
    <h1 class="sw__h">Before you set off</h1>
    <ol class="sw__checks">
      <li><strong>Headphones in.</strong> The sound is made to be heard around you, not from a speaker.</li>
      <li><strong>Phone charged</strong>, with location turned on. The walk knows where you are and the story arrives as you reach each place.</li>
      <li><strong>Download it on wi-fi.</strong> Then it plays without signal.</li>
      <li><strong>Keep your screen on</strong> while you walk, and keep your eyes on the road.</li>
    </ol>
    <p class="sw__fine" id="untilNote"></p>
    <button class="sw__btn" type="button" data-go="who">Begin</button>
  </section>

  <!-- 2. Who you are -->
  <section class="sw__screen" data-screen="who" hidden>
    <p class="sw__eyebrow">Choice 1 of 2</p>
    <h1 class="sw__h" id="whoQ"></h1>
    <div class="sw__choices" id="whoList" role="radiogroup"></div>
    <button class="sw__btn" type="button" data-go="narrator" id="whoNext" disabled>Next</button>
  </section>

  <!-- 3. Narrator -->
  <section class="sw__screen" data-screen="narrator" hidden>
    <p class="sw__eyebrow">Choice 2 of 2</p>
    <h1 class="sw__h" id="narQ"></h1>
    <div class="sw__choices" id="narList" role="radiogroup"></div>
    <button class="sw__btn" type="button" data-go="download" id="narNext" disabled>Next</button>
    <button class="sw__link" type="button" data-go="who">Back</button>
  </section>

  <!-- 4. Download -->
  <section class="sw__screen" data-screen="download" hidden>
    <p class="sw__eyebrow">Almost ready</p>
    <h1 class="sw__h">Download the walk</h1>
    <p class="sw__p">Do this on wi-fi before you leave. It saves the sound and pictures to this phone, so the walk plays even without signal.</p>
    <div class="sw__meter" aria-hidden="true"><span id="dlBar"></span></div>
    <p class="sw__fine" id="dlStatus" role="status">About <span id="dlSize">a few</span> MB.</p>
    <button class="sw__btn" type="button" id="dlBtn">Download</button>
    <button class="sw__link" type="button" data-go="start" id="dlSkip">Skip and stream as I go</button>
  </section>

  <!-- 5. Get to the start -->
  <section class="sw__screen" data-screen="start" hidden>
    <p class="sw__eyebrow">The walk begins at</p>
    <h1 class="sw__h" id="startName"></h1>
    <p class="sw__p" id="startWhere"></p>
    <div class="sw__map" id="startMap"></div>
    <p class="sw__dist" id="startDist" role="status">Finding you…</p>
    <button class="sw__btn" type="button" id="startBtn">I'm here. Start the walk</button>
    <p class="sw__fine">Tapping start turns on location and keeps your screen awake.</p>
  </section>

  <!-- 6. The walk: the map fills the screen; a card at the top says where you are in the story,
       the sheet at the bottom plays it -->
  <section class="sw__screen wk" data-screen="walk" hidden>
    <div class="wk__map" id="walkMap" aria-hidden="true"></div>
    <div class="wk__nomap" id="walkNoMap" hidden aria-hidden="true"><div class="sw__ring"><span></span><span></span><span></span></div></div>

    <header class="wk__card" id="wkCard">
      <div class="wk__card-text">
        <p class="wk__eyebrow" id="sceneNum"></p>
        <h1 class="wk__title" id="sceneTitle"></h1>
        <p class="wk__cue" id="sceneMode"></p>
      </div>
      <button class="wk__thumb" type="button" id="thumbBtn" hidden aria-label="See the photo again"><img id="thumbImg" alt=""></button>
    </header>

    <div class="wk__tools">
      <button class="wk__tool" type="button" id="listBtn" aria-expanded="false" aria-label="All scenes"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h10"/></svg></button>
      <button class="wk__tool" type="button" id="meBtn" aria-label="Centre the map on me"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4 4 11l7 2 2 7z"/></svg></button>
    </div>

    <div class="wk__sheet" id="wkSheet">
      <!-- on the way to the next scene -->
      <div class="wk__heading" id="headingBox">
        <div class="wk__go">
          <span class="wk__arrow" id="wkArrow" aria-hidden="true"><svg viewBox="0 0 40 40"><path d="M20 5 31 33 20 27 9 33z"/></svg></span>
          <div>
            <p class="wk__dist" id="nextDist" role="status">Finding you…</p>
            <p class="wk__place" id="nextPlace"></p>
          </div>
        </div>
        <div class="wk__row">
          <button class="wk__pill" type="button" id="prevBtn2">Previous</button>
          <button class="wk__here" type="button" id="hereBtn">I'm here</button>
        </div>
      </div>

      <!-- a scene playing -->
      <div class="wk__playing" id="playingBox" hidden>
        <div class="wk__scrub">
          <input type="range" id="scrub" min="0" max="1000" value="0" step="1" aria-label="Position in this scene">
          <div class="wk__times"><span id="tNow">0:00</span><span id="tLeft">-0:00</span></div>
        </div>
        <div class="wk__controls">
          <button class="wk__skip" type="button" id="backBtn" aria-label="Back 10 seconds"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M9 8a10 10 0 1 1-3 7"/><path d="M9 3v5h5"/></svg><span>10</span></button>
          <button class="wk__play" type="button" id="playBtn" aria-label="Pause"><i aria-hidden="true"></i><i aria-hidden="true"></i><svg class="wk__ico-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5h3v14H8zM13 5h3v14h-3z"/></svg><svg class="wk__ico-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></button>
          <button class="wk__skip" type="button" id="fwdBtn" aria-label="Forward 10 seconds"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M23 8a10 10 0 1 0 3 7"/><path d="M23 3v5h-5"/></svg><span>10</span></button>
        </div>
        <div class="wk__row">
          <button class="wk__pill" type="button" id="prevBtn">Previous</button>
          <button class="wk__pill" type="button" id="skipBtn">Next</button>
        </div>
      </div>

      <ol class="wk__scenes" id="sceneList" hidden></ol>
    </div>
    <p class="wk__toast" id="wkToast" role="status" hidden></p>
  </section>

  <!-- 7. The end -->
  <section class="sw__screen" data-screen="end" hidden>
    <p class="sw__eyebrow">Sonder</p>
    <h1 class="sw__h">Everyone you passed today has a life as full as yours.</h1>
    <p class="sw__p">Thank you for walking with us. You can walk Sonder again, with the other choices, as often as you like while your ticket lasts.</p>
    <button class="sw__btn" type="button" id="againBtn">Walk it again</button>
    <a class="sw__link" href="/">Riptide</a>
  </section>

  <div class="sw__photo" id="photo" hidden>
    <figure><img id="photoImg" alt=""><figcaption id="photoCap"></figcaption></figure>
    <button class="sw__link" type="button" id="photoClose">Close</button>
  </div>

  <audio id="player" preload="auto" playsinline></audio>
</div>

<noscript><p style="padding:24px;color:#f4f1e9">Sonder needs JavaScript and location to run. Please turn JavaScript on.</p></noscript>
<script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
<script src="/assets/js/sonder-walk.js?v={{ build.v }}"></script>
</body>
</html>
