{# The moving water behind page titles. The poster (a still) shows at once; the film itself
   starts loading only after the page has finished, a smaller cut on phones. #}
<video class="hero__media" muted loop playsinline preload="none" poster="/assets/video/waves-poster-800.webp" data-hero-src="/assets/video/waves.mp4" data-hero-src-small="/assets/video/waves-480.mp4"></video>
<script>(function(v){if(window.innerWidth>900)v.poster="/assets/video/waves-poster.webp"})(document.currentScript.previousElementSibling)</script>
