<script>
(function(){
  const RATES=[{id:"reduced",name:"Reduced",price:14},{id:"standard",name:"Standard",price:20},{id:"supporter",name:"Supporter",price:26}];
  const SERVICES=[
    {group:"Classes · 90 min",items:[
      {id:"hagen",name:"Uta Hagen Technique",detail:"First Tuesday of every month · new actors welcome",kind:"class",slot:{rule:"first",day:2,time:"18:00–19:30",janSecond:true},skip:["2026-11-03"]},
      {id:"surgery",name:"Audition Surgery",detail:"Last Sunday of the month",kind:"enquiry",waitlist:true},
      {id:"company",name:"Company",detail:"Weekly · by audition · £25/month",kind:"enquiry",audition:true}]},
    {group:"1:1 coaching · book online",items:[
      {id:"ds",name:"Drama School Admissions",detail:"Three tiers · £50 deposit to book",kind:"paid",deposit:50,opts:[{id:"ds-lighter",name:"Lighter tier",price:150},{id:"ds-standard",name:"Standard",price:300},{id:"ds-recalls",name:"Recalls",price:120}],optLabel:"Choose your tier"},
      {id:"tape",name:"Self-Tape Surgery",detail:"Online 1:1 · from £30",kind:"paid",opts:[{id:"tape-coach",name:"Online self-tape coaching · 60 min",price:45},{id:"tape-check",name:"Tape check · 30 min online",price:30}],optLabel:"Choose an option"}]}
  ];
  const all=SERVICES.flatMap(g=>g.items);
  const state={step:0,service:"hagen",date:null,rate:"standard",tier:"Standard · £300",item:"",pay:"deposit",name:"",email:"",notes:"",experience:"",speech:"",error:""};
  const opt=()=>{const s=svc();return s.opts?(s.opts.find(o=>o.id===state.item)||s.opts[s.id==="ds"?1:0]):null;};
  const due=()=>{const s=svc(),o=opt();return s.deposit&&state.pay==="deposit"?s.deposit:o.price;};
  let checkout=null;
  function loadStripe(){if(window.Stripe)return Promise.resolve(window.Stripe);return new Promise((ok,no)=>{const sc=document.createElement("script");sc.src="https://js.stripe.com/v3/";sc.async=true;sc.onload=()=>window.Stripe?ok(window.Stripe):no(new Error("stripe"));sc.onerror=no;document.head.appendChild(sc);});}
  const pane=document.getElementById("pane");
  const stepBtns=[...document.querySelectorAll(".steps button")];
  const step2=document.getElementById("step2label");
  const svc=()=>all.find(s=>s.id===state.service);
  const rate=()=>RATES.find(r=>r.id===state.rate);
  const fmt=d=>d.toLocaleDateString("en-GB",{weekday:"long",day:"numeric",month:"long"});
  function esc(v){return String(v).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));}

  function datesFor(s){
    const out=[],now=new Date();now.setHours(0,0,0,0);
    if(s.slot.rule==="weekly"){let d=new Date(now);d.setDate(d.getDate()+1);while(out.length<6){if(d.getDay()===s.slot.day)out.push(new Date(d));d.setDate(d.getDate()+1);}return out;}
    for(let m=0;out.length<4&&m<12;m++){
      const first=new Date(now.getFullYear(),now.getMonth()+m,1);
      let d=new Date(first);while(d.getDay()!==s.slot.day)d.setDate(d.getDate()+1);
      if(s.slot.rule==="third")d.setDate(d.getDate()+14);
      if(s.slot.janSecond&&d.getMonth()===0)d.setDate(d.getDate()+7);
      if(s.slot.rule==="last"){d=new Date(now.getFullYear(),now.getMonth()+m+1,0);while(d.getDay()!==s.slot.day)d.setDate(d.getDate()-1);}
      const iso=`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`;
      if(d>now&&!(s.skip||[]).includes(iso))out.push(d);
    }
    return out;
  }
  // Pledge model: a class date goes ahead once MIN actors pledge. SAMPLE = demo pledge counts per upcoming date.
  let MIN=10,CAP=14,COUNTS={};
  const isoOf=d=>`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`;
  const pl=(n,one,many)=>`${n} ${n===1?one:many}`;
  const short=d=>d.toLocaleDateString("en-GB",{weekday:"short",day:"numeric",month:"short"}).replace(",","");
  function pledgeFor(d){
    const n=COUNTS[isoOf(d)]||0,deadline=new Date(d);deadline.setDate(deadline.getDate()-7);
    return {n,go:n>=MIN,deadline,need:Math.max(MIN-n,0),left:Math.max(CAP-n,0)};
  }
  function canGo(n){
    const s=svc();
    if(n>=2&&s.kind==="class"&&(!state.date||!state.rate||(pledgeFor(state.date).go&&!pledgeFor(state.date).left)))return false;
    if(n>=3&&(!state.name.trim()||!/\S+@\S+\.\S+/.test(state.email)))return false;
    return true;
  }
  function go(n){if(canGo(n)){state.step=n;state.error="";render();}}

  function render(){
    const s=svc();
    step2.textContent=s.kind==="class"?"2 · Date & rate":"2 · Options";
    stepBtns.forEach((b,i)=>{b.removeAttribute("aria-current");if(i===state.step)b.setAttribute("aria-current","step");b.disabled=!canGo(i)||state.step===4;});
    if(state.step===0){
      pane.innerHTML=SERVICES.map(g=>`<div class="label">${g.group}</div><div class="choice-grid">${g.items.map(i=>`<button type="button" class="choice" data-id="${i.id}" aria-pressed="${i.id===state.service}"><span style="font-weight:600">${i.name}</span><span class="light">${i.detail}</span><span class="p">${i.kind==="class"?"£14 / £20 / £26":i.kind==="paid"?"Book":i.audition?"Apply":i.waitlist?"Join the waitlist":"Enquire"}</span></button>`).join("")}</div>`).join("")+
      `<div class="bar"><span class="note">Selected: <strong>${s.name}</strong></span><button type="button" class="btn solid" id="next">Continue</button></div>`;
      pane.querySelectorAll(".choice").forEach(b=>b.onclick=()=>{state.service=b.dataset.id;state.date=null;render();});
      pane.querySelector("#next").onclick=()=>go(1);
    }
    if(state.step===1){
      let html="";
      if(s.kind==="class"){
        const ds=datesFor(s);
        if(!state.date)state.date=ds[0];
        html+=`<div class="label">Choose a date · ${s.slot.time}</div><div class="dates">${ds.map((d,i)=>`<button type="button" class="date" data-i="${i}" aria-pressed="${d.getTime()===state.date.getTime()}"><span>${d.toLocaleDateString("en-GB",{weekday:"short"})}</span><strong>${d.getDate()}</strong><span>${d.toLocaleDateString("en-GB",{month:"short",year:"numeric"})}</span>${(q=>q.go?`<em class="go">Going ahead</em><em>${q.left?pl(q.left,"space","spaces")+" left":"Full"}</em>`:`<em>${q.need} more needed</em>`)(pledgeFor(d))}</button>`).join("")}</div>`;
        const p=pledgeFor(state.date);
        html+=`<div class="pledge${p.go?" is-go":""}" aria-live="polite">
          ${p.go?`<span class="go-badge"><i aria-hidden="true">✓</i>Going ahead</span>
          <p><strong>${p.left?pl(p.left,"space","spaces")+" left":"Fully booked"}</strong></p>
          <p class="note">${p.left?"This session is definitely running. Save your place now and we'll send you a link to pay.":"This session is full. Choose another date."}</p>`
          :`<span class="label">Pledges for ${short(state.date)}</span>
          <div class="seats" role="img" aria-label="${pl(p.need,"more actor","more actors")} needed">${Array.from({length:p.need},()=>`<i></i>`).join("")}</div>
          <p><strong>${pl(p.need,"more actor","more actors")} needed to go ahead · by ${short(p.deadline)}</strong></p>
          <p class="note">Pledge now and pay nothing yet. If enough actors pledge by ${short(p.deadline)}, the session goes ahead and you'll get a link to pay. If not, you pay nothing.</p>`}
        </div>`;
        html+=`<div class="label">Choose your rate</div><div class="choice-grid">${RATES.map(r=>`<button type="button" class="choice rate-c" data-r="${r.id}" aria-pressed="${r.id===state.rate}"><span style="font-weight:600">${r.name}</span><span class="p">£${r.price}</span></button>`).join("")}</div>`;
        html+=`<div class="bar"><button type="button" class="btn" id="back">Back</button><button type="button" class="btn solid" id="next">Add your details</button></div>`;
        pane.innerHTML=html;
        pane.querySelectorAll(".date").forEach(b=>b.onclick=()=>{state.date=ds[+b.dataset.i];render();});
        pane.querySelectorAll(".rate-c").forEach(b=>b.onclick=()=>{state.rate=b.dataset.r;render();});
      } else if(s.kind==="paid"){
        state.item=opt().id;
        html+=`<div class="label">${s.optLabel}</div><div class="choice-grid">${s.opts.map(o=>`<button type="button" class="choice opt-c" data-o="${o.id}" aria-pressed="${o.id===state.item}"><span style="font-weight:600">${o.name}</span><span class="p">£${o.price}</span></button>`).join("")}</div>`;
        if(s.deposit)html+=`<div class="label">How would you like to pay?</div><div class="choice-grid"><button type="button" class="choice pay-c" data-p="deposit" aria-pressed="${state.pay==="deposit"}"><span style="font-weight:600">£${s.deposit} deposit</span><span class="light">Non-refundable · comes off the full fee</span></button><button type="button" class="choice pay-c" data-p="full" aria-pressed="${state.pay==="full"}"><span style="font-weight:600">Pay in full</span><span class="p">£${opt().price}</span></button></div>`;
        html+=`<p class="note">After paying you'll choose a time for your session.</p><div class="bar"><button type="button" class="btn" id="back">Back</button><button type="button" class="btn solid" id="next">Add your details</button></div>`;
        pane.innerHTML=html;
        pane.querySelectorAll(".opt-c").forEach(b=>b.onclick=()=>{state.item=b.dataset.o;render();});
        pane.querySelectorAll(".pay-c").forEach(b=>b.onclick=()=>{state.pay=b.dataset.p;render();});
      } else if(s.tiers){
        if(!s.tiers.includes(state.tier))state.tier=s.id==="ds"?"Standard · £300":s.tiers[0];
        html+=`<div class="label">${s.tierLabel||"Which tier are you interested in?"}</div><div class="choice-grid">${s.tiers.map(t=>`<button type="button" class="choice tier-c" data-t="${esc(t)}" aria-pressed="${t===state.tier}"><span style="font-weight:600">${t}</span></button>`).join("")}</div>`;
        html+=`<div class="bar"><button type="button" class="btn" id="back">Back</button><button type="button" class="btn solid" id="next">Add your details</button></div>`;
        pane.innerHTML=html;
        pane.querySelectorAll(".tier-c").forEach(b=>b.onclick=()=>{state.tier=b.dataset.t;render();});
      } else {
        html+=`<p class="note">${s.audition?"Company auditions are held three times a year. Apply and we'll send you details of the next round.":s.waitlist?"Audition Surgeries will run on the last Sunday of the month. Join the waitlist and we'll let you know when dates are confirmed.":"Send an enquiry and we'll be in touch to arrange your session."}</p><div class="bar"><button type="button" class="btn" id="back">Back</button><button type="button" class="btn solid" id="next">Add your details</button></div>`;
        pane.innerHTML=html;
      }
      pane.querySelector("#back").onclick=()=>go(0);
      pane.querySelector("#next").onclick=()=>go(2);
    }
    if(state.step===2){
      const ask=s.id==="ds"?"Which schools are you applying to, and when are your deadlines?":s.id==="tape"?"What's the tape for, and when is it due?":s.audition?"Tell us a little about your training and experience":"Anything we should know?";
      const speech=s.id==="surgery"?`<label class="f full">Speech<select id="bk-speech">${["My own speech","One of this month's released speeches"].map(o=>`<option ${o===state.speech?"selected":""}>${o}</option>`).join("")}</select></label>`:"";
      pane.innerHTML=`<form class="details" id="f" novalidate>
        <label class="f">Full name<input id="bk-name" autocomplete="name" value="${esc(state.name)}" required></label>
        <label class="f">Email<input id="bk-email" type="email" autocomplete="email" value="${esc(state.email)}" required></label>
        <label class="f full">Acting experience<select id="bk-exp">${["","Currently in training","Recent graduate","Working professionally","Other"].map(o=>`<option ${o===state.experience?"selected":""} value="${o}">${o||"Choose one (optional)"}</option>`).join("")}</select></label>
        ${speech}
        <label class="f full">${ask}<textarea id="bk-notes" rows="3">${esc(state.notes)}</textarea></label>
        <input id="bk-web" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px">
        ${state.error?`<p class="err full">${state.error}</p>`:""}
        <div class="bar full"><button type="button" class="btn" id="back">Back</button><button type="submit" class="btn solid">Review</button></div>
      </form>`;
      const f=pane.querySelector("#f");
      const sync=()=>{state.name=f.querySelector("#bk-name").value;state.email=f.querySelector("#bk-email").value;state.experience=f.querySelector("#bk-exp").value;state.notes=f.querySelector("#bk-notes").value;const sp=f.querySelector("#bk-speech");if(sp)state.speech=sp.value;};
      f.addEventListener("input",sync);
      f.addEventListener("submit",e=>{e.preventDefault();sync();if(!canGo(3)){state.error="Add your name and a valid email address to continue.";render();return;}go(3);});
      pane.querySelector("#back").onclick=()=>{sync();go(1);};
    }
    if(state.step===3){
      const cls=s.kind==="class",p=cls?pledgeFor(state.date):null,pledge=cls&&!p.go;
      pane.innerHTML=`<dl class="summary">
        <dt>${cls||s.kind==="paid"?(pledge?"Pledge":"Booking"):s.audition?"Application":s.waitlist?"Waitlist":"Enquiry"}</dt><dd>${s.name}${s.tiers?` · ${esc(state.tier)}`:""}${s.kind==="paid"?` · ${opt().name}`:""}</dd>
        ${s.kind==="paid"?`<dt>Pay now</dt><dd>£${due()}${s.deposit&&state.pay==="deposit"?` deposit (non-refundable) · £${opt().price-s.deposit} before your first session`:""}</dd>`:""}
        ${cls?`<dt>When</dt><dd>${fmt(state.date)}, ${s.slot.time}</dd><dt>Rate</dt><dd>${rate().name} · £${rate().price}</dd>`:""}
        ${s.id==="surgery"?`<dt>Speech</dt><dd>${esc(state.speech||"My own speech")}</dd>`:""}
        <dt>Name</dt><dd>${esc(state.name)}</dd>
        <dt>Email</dt><dd>${esc(state.email)}</dd>
      </dl>
      ${state.error?`<p class="err">${state.error}</p>`:""}
      <div class="bar"><button type="button" class="btn" id="back">Edit details</button><button type="button" class="btn solid" id="confirm">${s.kind==="paid"?`Pay £${due()}`:pledge?`Pledge £${rate().price} · pay nothing now`:cls?`Save my place · £${rate().price}`:s.audition?"Send application":s.waitlist?"Join the waitlist":"Send enquiry"}</button></div>`;
      pane.querySelector("#back").onclick=()=>{state.error="";go(2);};
      const cb=pane.querySelector("#confirm");
      if(s.kind==="paid"){cb.onclick=async()=>{
        cb.disabled=true;cb.textContent="Opening secure payment…";
        try{
          const r=await fetch("/api/las/checkout",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({item:opt().id,pay:s.deposit?state.pay:"full",name:state.name,email:state.email,experience:state.experience,notes:state.notes,website:(document.getElementById("bk-web")||{}).value||""})});
          const j=await r.json().catch(()=>({}));
          if(!r.ok)throw new Error(j.error||"checkout");
          const S=await loadStripe();
          if(checkout){try{checkout.destroy();}catch(e){}}
          checkout=await S(j.publishableKey).initEmbeddedCheckout({fetchClientSecret:()=>Promise.resolve(j.clientSecret)});
          pane.innerHTML=`<div class="label">Secure payment · £${due()}</div><div id="las-pay"></div><div class="bar"><button type="button" class="btn" id="back">Change something</button></div>`;
          checkout.mount("#las-pay");
          pane.querySelector("#back").onclick=()=>{try{checkout.destroy();}catch(e){}checkout=null;go(3);};
        }catch(e){
          state.error=e.message==="setup"?"Online booking isn't open quite yet. Please email leedsactorsstudio@gmail.com.":"Something went wrong opening the payment. Please try again, or email leedsactorsstudio@gmail.com.";
          render();
        }
      };return;}
      cb.onclick=async()=>{
        cb.disabled=true;cb.textContent="Sending…";
        const body={service:s.id,name:state.name,email:state.email,experience:state.experience,notes:state.notes,website:(document.getElementById("bk-web")||{}).value||""};
        if(cls){body.date=isoOf(state.date);body.rate=state.rate;}
        if(s.tiers)body.tier=state.tier;
        if(s.id==="surgery")body.speech=state.speech||"My own speech";
        try{
          const r=await fetch("/api/las/signup",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});
          const j=await r.json().catch(()=>({}));
          if(!r.ok)throw new Error(j.error||"send");
          state.wasPledge=pledge;
          if(cls&&typeof j.count==="number")COUNTS[isoOf(state.date)]=j.count;
          state.error="";state.step=4;render();
        }catch(e){
          state.error=e.message==="full"?"Sorry, that date has just filled up. Choose another date.":"Something went wrong sending that. Please try again, or email leedsactorsstudio@gmail.com.";
          render();
        }
      };
    }
    if(state.step===4){
      const cls=s.kind==="class",p=cls?pledgeFor(state.date):null,pledge=cls&&state.wasPledge;
      pane.innerHTML=`<div style="display:grid;gap:14px"><span class="mark label"><i class="dot"></i>${pledge?"Pledge received":cls?"Place saved":s.audition?"Application sent":s.waitlist?"You're on the waitlist":"Enquiry sent"}</span><h3 style="font-size:1.8rem">${cls&&!pledge?"See you in the room":"Thanks"}, ${esc(state.name.split(" ")[0]||"")}.</h3>
      <p>${s.name}${cls?` · ${fmt(state.date)}, ${s.slot.time}`:""}</p>
      ${pledge?`<p>You've pledged £${rate().price}. You'll hear by ${fmt(p.deadline)} whether the session is going ahead. Nothing is charged unless it is.</p>`:""}
      <p class="note">We've emailed you a copy.</p>
      <div class="bar"><button type="button" class="btn" id="again">Start again</button></div></div>`;
      pane.querySelector("#again").onclick=()=>{Object.assign(state,{step:0,date:null,notes:""});render();};
    }
  }
  stepBtns.forEach(b=>b.onclick=()=>go(+b.dataset.step));
  document.querySelectorAll("[data-pick]").forEach(a=>a.addEventListener("click",()=>{state.service=a.dataset.pick;state.date=null;state.step=1;render();}));
  render();
  try{
    const ds=datesFor(all.find(x=>x.id==="hagen")).map(isoOf);
    fetch("/api/las/pledges?dates="+ds.join(",")).then(r=>r.ok?r.json():null).then(j=>{if(j){COUNTS=j.counts||{};MIN=j.min||MIN;CAP=j.cap||CAP;render();}}).catch(()=>{});
  }catch(e){}
})();
</script>

<script>
(function(){
  if(!("IntersectionObserver" in window))return;
  try{if(matchMedia("(prefers-reduced-motion: reduce)").matches)return;}catch(e){}
  var els=[].slice.call(document.querySelectorAll(".rect-photo,.circle-photo,.wide-band,.portrait,.apply-photo"));
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add("in");io.unobserve(e.target);}});},{rootMargin:"0px 0px -80px 0px"});
  els.forEach(function(el){if(el.getBoundingClientRect().top>innerHeight){el.classList.add("rv");io.observe(el);}});
})();
</script>
