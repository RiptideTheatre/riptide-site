<script>
(function(){
  const f=document.getElementById("apply-form"),done=document.getElementById("ap-done"),err=document.getElementById("ap-err");
  f.addEventListener("submit",e=>{
    e.preventDefault();
    const name=f.querySelector("#ap-name").value.trim(),email=f.querySelector("#ap-email").value;
    if(!name||!/\S+@\S+\.\S+/.test(email)){err.hidden=false;return;}
    const btn=f.querySelector("button[type=submit]");btn.disabled=true;err.hidden=true;
    fetch("/api/las/signup",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({service:"company",name:name,email:email,notes:f.querySelector("#ap-notes").value})})
      .then(function(r){if(!r.ok)throw new Error("send");
        document.getElementById("ap-thanks").textContent="Thanks, "+name.split(" ")[0]+".";
        f.hidden=true;done.hidden=false;})
      .catch(function(){err.textContent="Something went wrong sending that. Please try again, or email leedsactorsstudio@gmail.com.";err.hidden=false;btn.disabled=false;});
  });
})();
</script>
<script>
(function(){
  if(!("IntersectionObserver" in window))return;
  try{if(matchMedia("(prefers-reduced-motion: reduce)").matches)return;}catch(e){}
  var els=[].slice.call(document.querySelectorAll(".rect-photo,.circle-photo,.wide-band,.portrait,.apply-photo"));
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add("in");io.unobserve(e.target);}});},{rootMargin:"0px 0px -80px 0px"});
  els.forEach(function(el){if(el.getBoundingClientRect().top>innerHeight){el.classList.add("rv");io.observe(el);}});
})();
</script>
