---
layout: base.njk
title: What's on
permalink: /whats-on/
description: Riptides swelling, riptides forming, and riptides happening right now. Everything Riptide currently has on, with dates, prices and access details.
---

<section class="band band--flush band--waves">
  {% include "page-waves.njk" %}
  <div class="wrap">
    <h1 class="display" style="font-size: clamp(40px, 6vw, 72px); line-height: 1; margin: 0;">What's on</h1>
    <p class="lede">Riptides swelling, riptides forming, and riptides happening right now.</p>
    <div class="filters" role="group" aria-label="Show only" data-filters hidden>
      <button type="button" data-kind="" aria-pressed="true">All</button>
      <button type="button" data-kind="in-person" aria-pressed="false">In person</button>
      <button type="button" data-kind="at-home" aria-pressed="false">At home</button>
      <button type="button" data-kind="one-to-one" aria-pressed="false">One to one</button>
      <button type="button" data-kind="free" aria-pressed="false">Free</button>
    </div>
    <p class="visually-hidden" role="status" id="filterStatus"></p>
  </div>
</section>

<section class="band band--flush" style="padding-top: 8px;">
  <div class="wrap">

    {% for show in collections.current %}
    {% if loop.first or show.data.bigListing %}
    <article class="listing listing--featured" data-kinds="{{ (show.data.kinds or []) | join(' ') }}">
      <a class="listing__media" href="{{ show.url }}" tabindex="-1" aria-hidden="true"><img src="{{ show.data.image }}" alt="" width="1200" height="675"></a>
      <div class="listing__body">
        <span class="badge badge--{{ show.data.status | statusTone }}">{{ show.data.status | statusLabel }}</span>
        <h2><a href="{{ show.url }}">{{ show.data.title }}</a></h2>
        <p class="listing__tagline">{{ show.data.tagline }}</p>
        <p style="color: var(--muted); margin: 14px 0 0;">{{ show.data.summary }}</p>
        {% if show.data.facts %}
        <dl class="facts">
          {% for fact in show.data.facts | batch(4) | first %}<dt>{{ fact.label }}</dt><dd>{{ fact.value }}</dd>{% endfor %}
        </dl>
        {% endif %}
        <div class="listing__actions">
          <a class="btn btn--primary" href="{{ show.data | bookHref(show.url) }}">{{ show.data.ctaLabel or (show.data.status | statusCta) }}</a>
          <a href="{{ show.url }}">Full details</a>
        </div>
      </div>
    </article>
    {% else %}
    <article class="listing listing--compact" data-kinds="{{ (show.data.kinds or []) | join(' ') }}">
      <a class="listing__media" href="{{ show.url }}" tabindex="-1" aria-hidden="true"><img src="{{ show.data.image }}" alt="" width="1200" height="675" loading="lazy"></a>
      <div class="listing__body">
        <div style="max-width: 62ch;">
          <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
            <h2><a href="{{ show.url }}">{{ show.data.title }}</a></h2>
            <span class="badge badge--{{ show.data.status | statusTone }}">{{ show.data.status | statusLabel }}</span>
          </div>
          <p style="color: var(--muted); margin: 12px 0 0;">{{ show.data.summary }}</p>
          <p style="color: var(--quiet); font-size: 14px; margin: 12px 0 0;">{{ show.data.cardMeta }}</p>
        </div>
        <div class="listing__btns">
          {% if show.data.bookable %}<a class="btn btn--primary" href="{{ show.data | bookHref(show.url) }}">Book tickets</a>{% endif %}
          <a class="btn btn--ghost" href="{{ show.url }}">Details</a>
        </div>
      </div>
    </article>
    {% endif %}
    {% endfor %}
    <p class="filters__none" id="filterNone" hidden>Nothing of that kind is on right now. <button type="button" class="filters__reset" data-kind="">Show everything</button></p>

  </div>
</section>
<script>
/* What's on filters: show only one kind of experience, without reloading the page. */
(function () {
  var box = document.querySelector('[data-filters]'); if (!box) return;
  var items = [].slice.call(document.querySelectorAll('[data-kinds]'));
  var buttons = [].slice.call(box.querySelectorAll('button'));
  var none = document.getElementById('filterNone'), status = document.getElementById('filterStatus');
  function apply(kind, push) {
    var shown = 0;
    items.forEach(function (el) {
      var on = !kind || (' ' + el.getAttribute('data-kinds') + ' ').indexOf(' ' + kind + ' ') > -1;
      el.hidden = !on; if (on) shown++;
    });
    buttons.forEach(function (b) { b.setAttribute('aria-pressed', b.getAttribute('data-kind') === kind ? 'true' : 'false'); });
    none.hidden = shown > 0;
    status.textContent = kind ? 'Showing ' + shown + (shown === 1 ? ' experience' : ' experiences') : 'Showing everything';
    if (push) { var u = new URL(location.href); if (kind) u.searchParams.set('kind', kind); else u.searchParams.delete('kind'); history.replaceState(null, '', u); }
  }
  box.addEventListener('click', function (e) { var b = e.target.closest('button'); if (b) apply(b.getAttribute('data-kind'), true); });
  none.querySelector('button').addEventListener('click', function () { apply('', true); });
  box.hidden = false;
  var start = new URLSearchParams(location.search).get('kind') || '';
  if (start && !buttons.some(function (b) { return b.getAttribute('data-kind') === start; })) start = '';
  apply(start, false);
})();
</script>

<section class="band">
  <div class="wrap split">
    <div>
      <h2 class="display" style="font-size: clamp(26px, 3vw, 36px); margin: 0;">Looking for something we've already made?</h2>
      <p style="color: var(--muted); margin: 12px 0 0;">The Lucky Ones and everything before it — with dates, venues, credits, images and press for each.</p>
    </div>
    <div><a class="btn btn--outline" href="/archive/">Browse past work</a></div>
  </div>
</section>
